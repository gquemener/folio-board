#!/usr/bin/env python3
"""Mirror what you draw on a Wacom SmartPad into a window, live.

Usage: folio-board [BLUETOOTH_ADDRESS]
Keys: & é " ' ( - è _ ç pen color (French keyboard), c clear, r portrait / landscape,
p pressure on/off, o shapes on/off, Ctrl+S save, Ctrl+C copy as SVG, q / Esc quit.
Drag with the mouse to pick the area to save or copy; click outside it to use the whole
page again.

The code lives in the folio_board package next to this file, even when it is run through a symlink.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from folio_board.startup import main  # noqa: E402

if __name__ == '__main__':
    main(sys.argv)
